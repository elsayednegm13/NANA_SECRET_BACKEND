PORT=4000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Development defaults only. Configure strong credentials for a NEW production DB.
ADMIN_USER=ADMIN
ADMIN_PASS=123
# Existing passwords depend on this value: preserve the old secret when migrating.
SESSION_SECRET=local-secret

# Relative paths resolve from backend/, not the shell's working directory.
DATA_DIR=data
UPLOADS_DIR=uploads

# Optional contact form email. Never put this key in frontend configuration.
RESEND_API_KEY=
CONTACT_TO=elsayedmohamed963@gmail.com
RESEND_FROM="NANA SECRET Website <onboarding@resend.dev>"
